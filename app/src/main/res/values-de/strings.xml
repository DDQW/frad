    <string name="profile_delete">Löschen</string>
    <string name="profile_delete_all_explainer">Löscht deine Identität, dein Profil, deine Kontakte, den Chatverlauf, empfangene Dateien und die Blockierliste von diesem Handy und schließt FRAD. Leute, mit denen du gechattet hast, behalten nur, was sie selbst gespeichert haben.</string>
    <string name="profile_delete_all_title">Alle meine Daten löschen</string>
    <string name="profile_delete_everything">Alles löschen</string>
