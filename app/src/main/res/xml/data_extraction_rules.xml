<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of FRAD's leaves the phone through backups or a device-to-device transfer: the
     identity and saved chats are sealed with a Keystore key that stays behind anyway (see
     crypto/StorageCipher.kt), and contacts/block lists are nobody else's business. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
