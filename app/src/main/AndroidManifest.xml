<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE discovery + chat transport (M1). No location permission is requested:
         targeting API 31+ neverForLocation BLE scanning, so presence discovery
         cannot be repurposed to infer the user's location. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        tools:targetApi="31"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="31" />

    <!-- Legacy BLE scan permissions for API 26-30 devices, where BLE scanning is
         still gated behind coarse location even though no location is ever read. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Wide-range (M4) "Use my area" button only - a coarse, one-shot fix immediately reduced
         to a geohash cell and discarded (see wideradius/CoarseLocation.kt); never requested as
         part of BLE's own permission set above, and the wide-range layer works without it too
         (manual geohash entry). No maxSdkVersion cap, unlike the legacy BLE-only grant it used
         to double as - this one is requested at any API level, on demand, only when that button
         is tapped. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Wi-Fi Direct file transfer (M3), only ever used from API 29+ (see BleChatController) -
         so the feature itself is optional, unlike BLE which the app can't run without. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        tools:targetApi="33"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />

    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />

    <!-- Wide-range discovery/chat/file-transfer (M4) - the go-libp2p layer. M1-M3 needed no
         internet access at all; this is the first FRAD feature that does. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FradApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Frad">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Frad">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets a received file (M3) be handed to another app via ACTION_VIEW without
             exposing the app's private storage directly. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
