# Copy this file to `keystore.properties` (already gitignored - never commit
# the real one) to sign release builds with a real key instead of the
# auto-generated debug keystore. See the "F-Droid release packaging" section
# of the README for context: F-Droid builds and signs its own APK from source
# regardless, so this is only for APKs this repo publishes itself (GitHub
# Releases). Generate a key with, e.g.:
#
#   keytool -genkeypair -v -keystore release.keystore -alias frad-release \
#       -keyalg RSA -keysize 4096 -validity 10000
#
# Back up release.keystore and these passwords somewhere safe outside this
# repo - losing them means every future release needs a new signing key,
# which breaks in-place updates for anyone who installed an earlier one.

storeFile=/absolute/path/to/release.keystore
storePassword=changeit
keyAlias=frad-release
keyPassword=changeit
